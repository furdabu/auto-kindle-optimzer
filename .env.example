# ===== API サーバー =====
# iOS ショートカットの Authorization ヘッダに埋め込むトークン（任意のランダム文字列）
API_TOKEN=change-me-to-a-long-random-string
PORT=3847

# ===== ストレージ =====
DATA_DIR=./data
TMP_DIR=./tmp
# アップロード PDF の上限サイズ（MB）
MAX_UPLOAD_MB=100

# ===== KCC 変換設定 =====
# kcc-c2e バイナリのパス（Docker 内では PATH 上の kcc-c2e）
KCC_BIN=kcc-c2e
# デバイスプロファイル。Kindle Paperwhite 12 は KCC では KPW6（1272x1696, v9.7.2+）
KCC_PROFILE=KPW6
# 出力形式。Send to Kindle は MOBI 非推奨のため EPUB を推奨
KCC_FORMAT=EPUB
# マンガモード（右開き・見開き分割）: true/false
KCC_MANGA_STYLE=true
# 見開きページの処理: 0=分割 / 1=回転 / 2=両方
KCC_SPLITTER=1
# 低解像度画像を端末解像度まで拡大する: true/false
KCC_UPSCALE=true
# JPEG ではなく PNG で出力する: true/false
KCC_FORCE_PNG=true
# 変換タイムアウト（ミリ秒）
KCC_TIMEOUT_MS=1200000

# ===== Send to Kindle（メール配信）=====
# 端末固有の Send to Kindle アドレス（例: yourname@kindle.com）
KINDLE_EMAIL=yourname@kindle.com
# 送信元 SMTP（例は Gmail。アプリパスワードを使用）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-google-account@gmail.com
SMTP_PASS=your-app-password
# Amazon の「承認済み個人用ドキュメント Eメールリスト」に登録した送信元アドレス
SMTP_FROM=your-google-account@gmail.com
